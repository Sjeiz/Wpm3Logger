{
    "type": "object",
    "description": "Manifest describing ISG tester registers with optional Modbus metadata.",
    "patternProperties": {
        "^[0-9]+$": {
            "type": "object",
            "required": [
                "id",
                "description",
                "datatype",
                "unit",
                "access",
                "min",
                "max",
                "category",
                "show",
                "analyze",
                "modbus"
            ],
            "properties": {
                "id": {
                    "type": "integer",
                    "description": "Register number as used by ISG tester."
                },
                "description": {
                    "type": ["string", "null"],
                    "description": "Human-readable description of the register."
                },
                "datatype": {
                    "type": "string",
                    "enum": ["int16", "uint16", "int32", "uint32"],
                    "description": "Native datatype of the ISG tester value."
                },
                "unit": {
                    "type": "string",
                    "description": "Unit of measurement, empty string if none."
                },
                "access": {
                    "type": "string",
                    "enum": ["ro", "rw"],
                    "description": "Read/write capability."
                },
                "min": {
                    "type": ["number", "integer"],
                    "description": "Minimum allowed value."
                },
                "max": {
                    "type": ["number", "integer"],
                    "description": "Maximum allowed value."
                },
                "category": {
                    "type": "string",
                    "description": "Logical grouping (sensor, flag, energy, engineering, unknown)."
                },
                "show": {
                    "type": "boolean",
                    "description": "Whether to show this register in UI."
                },
                "analyze": {
                    "type": "boolean",
                    "description": "Whether this register is used in analytics."
                },
                "modbus": {
                    "type": ["object", "null"],
                    "description": "Optional official Modbus mapping.",
                    "properties": {
                        "address": {
                            "type": "integer",
                            "description": "1-based Modbus register address."
                        },
                        "type": {
                            "type": "string",
                            "enum": ["input_register", "holding_register"],
                            "description": "Modbus register type."
                        },
                        "span": {
                            "type": "integer",
                            "enum": [1, 2],
                            "description": "Number of Modbus registers (1 for 16-bit, 2 for 32-bit)."
                        }
                    },
                    "required": ["address", "type", "span"]
                }
            },
            "knx": {
                "type": ["object", "null"],
                "description": "Optional official KNX mapping.",
                "properties": {
                    "commObjID": {
                        "type": "integer",
                        "description": "KNX communication object ID."
                    },
                    "dpt": {
                        "type": "string",
                        "description": "KNX datapoint type (e.g. 1.xxx, 5.xxx, 9.xxx, 14.xxx)."
                    },
                    "flags": {
                        "type": "array",
                        "items": {
                            "type": "string",
                            "enum": ["T", "U", "R", "W", "C"]
                        },
                        "description": "KNX object flags: T=Transmit, U=Update, R=Read, W=Write, C=Communication."
                    },
                    "priority": {
                        "type": "string",
                        "enum": ["low", "normal", "alarm"],
                        "description": "KNX priority class."
                    }
                },
                "required": ["commObjID"]
            },
            "sentinel": {
                "type": ["object", "null"],
                "description": "Optional register-specific sentinel values for notset and notavailable.",
                "properties": {
                    "notset": {
                        "type": ["number", "integer", "null"],
                        "description": "Value indicating that the register has not been set."
                    },
                    "notavailable": {
                        "type": ["number", "integer", "null"],
                        "description": "Value indicating that the register is currently not available."
                    }
                },
                "required": []
            }
        }
    },
    "additionalProperties": false
}
